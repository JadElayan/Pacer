# --- AI (server-side only). Without a key, Pacer runs AI in clearly labeled DEMO MODE. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional cheaper model for topic titles, practice questions and teacher tips (e.g. claude-haiku-5-5).
ANTHROPIC_LIGHT_MODEL=
# Optional daily AI budgets in token units (1 unit ~ 1 input token; output counts 5x). Defaults shown.
# The global one is the hard ceiling on a day's AI bill (40M ~ $80 on Claude Sonnet 5.5). Lower it while testing.
AI_UNITS_PER_DEVICE_DAY=600000
AI_UNITS_PER_ROOM_DAY=4000000
AI_UNITS_GLOBAL_DAY=40000000

# --- Real multi-device sync (Supabase Realtime Broadcast). Without these, Pacer syncs only between
# --- tabs of the SAME browser (BroadcastChannel) and says so in the UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Accounts (optional). Turn on only after enabling the Google provider in Supabase Auth. ---
NEXT_PUBLIC_AUTH_ENABLED=

# --- Teacher cloud storage (optional). Saves teacher rooms and slides to the teacher's account so they
# --- open on any device. Needs accounts on and supabase/pacer_cloud_storage.sql applied. Set to 1 to turn on.
NEXT_PUBLIC_TEACHER_STORAGE_ENABLED=
